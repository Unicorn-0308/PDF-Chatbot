# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=thinkai-docs

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/thinkai
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/thinkai?retryWrites=true&w=majority

# NextAuth Configuration (for production)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl

# Application Configuration
NEXT_PUBLIC_APP_NAME=ThinkAI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vector Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Chat Configuration
MAX_TOKENS=2048
TEMPERATURE=0.7
TOP_K_RESULTS=5
